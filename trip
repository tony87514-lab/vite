// --- Custom Hook 處理 Firebase 狀態與資料 (保持主要邏輯不變) ---
const useItinerary = () => {
    const [userId, setUserId] = useState(null);
    const [isAuthReady, setIsAuthReady] = useState(false);
    const [itinerary, setItinerary] = useState(DEFAULT_ITINERARY);
    const [isLoading, setIsLoading] = useState(true);
    const [isDbInitialized, setIsDbInitialized] = useState(isEnvReady); // 使用新的環境檢查

    useEffect(() => {
        if (!auth) {
            setIsLoading(false);
            return;
        }

        // 處理認證：由於我們在 GitHub 上，通常只使用匿名登入
        const handleAuth = async () => {
            try {
                // 忽略 initialAuthToken，直接匿名登入
                await signInAnonymously(auth);
            } catch (error) {
                console.error("Firebase 登入失敗:", error);
                setUserId(auth.currentUser?.uid || 'anonymous-failed-auth');
            }
        };
        handleAuth();

        const unsubscribeAuth = onAuthStateChanged(auth, (user) => {
            if (user) {
                setUserId(user.uid);
            } else {
                setUserId(crypto.randomUUID());
            }
            setIsAuthReady(true);
        });

        return () => unsubscribeAuth();
    }, []);

    const itineraryDocPath = useMemo(() => {
        if (!userId) return null;
        // 使用私有資料路徑: /artifacts/{appId}/users/{userId}/itineraries/{ITINERARY_DOC_ID}
        return `artifacts/${appId}/users/${userId}/itineraries/${ITINERARY_DOC_ID}`;
    }, [userId]);

    // 實時監聽資料庫
    useEffect(() => {
        if (!isAuthReady || !db || !itineraryDocPath) {
            if (isAuthReady) setIsLoading(false);
            return;
        }

        const docRef = doc(db, itineraryDocPath);
        
        const unsubscribeSnapshot = onSnapshot(docRef, (docSnap) => {
            if (docSnap.exists() && docSnap.data().data) {
                const loadedData = JSON.parse(docSnap.data().data);
                setItinerary(loadedData);
            } else {
                saveItinerary(DEFAULT_ITINERARY);
            }
            setIsLoading(false);
        }, (error) => {
            console.error("Firestore 監聽失敗:", error);
            setIsLoading(false);
        });

        return () => unsubscribeSnapshot();
    }, [isAuthReady, db, itineraryDocPath]);


    // 儲存行程到 Firestore
    const saveItinerary = useCallback(async (newItinerary) => {
        if (!db || !itineraryDocPath || !userId) {
            console.error("資料庫未就緒，無法儲存。");
            return false;
        }

        try {
            await setDoc(doc(db, itineraryDocPath), {
                userId: userId,
                data: JSON.stringify(newItinerary),
                updatedAt: new Date().toISOString(),
            });
            setItinerary(newItinerary);
            return true;
        } catch (e) {
            console.error("儲存行程時出錯: ", e);
            return false;
        }
    }, [db, itineraryDocPath, userId]);

    // 處理活動更新
    const updateActivity = useCallback(async (dayIndex, activityId, updates) => {
        const newItinerary = itinerary.map((day, index) => {
            if (index !== dayIndex) return day;

            return {
                ...day,
                activities: day.activities.map(activity => 
                    activity.id === activityId ? { ...activity, ...updates } : activity
                )
            };
        });
        
        await saveItinerary(newItinerary);
    }, [itinerary, saveItinerary]);

    return { itinerary, updateActivity, isLoading, userId, isDbInitialized };
};

// --- Activity Card Component (略，與原版相同) ---
// 為保持單一檔案原則，請在實際操作時將 ActivityCard 和 DayColumn 保持在 App.jsx 內。
const ActivityCard = React.memo(({ dayIndex, activity, updateActivity }) => {
    // 此處為 ActivityCard 的完整實現
    const [isEditing, setIsEditing] = useState(false);
    const [tempTitle, setTempTitle] = useState(activity.title);
    const [tempDetail, setTempDetail] = useState(activity.detail);
    const [tempTime, setTempTime] = useState(activity.time);

    useEffect(() => {
        setTempTitle(activity.title);
        setTempDetail(activity.detail);
        setTempTime(activity.time);
    }, [activity]);

    const handleSave = () => {
        updateActivity(dayIndex, activity.id, {
            title: tempTitle,
            detail: tempDetail,
            time: tempTime,
        });
        setIsEditing(false);
    };
    
    // 定義樣式
    const cardClasses = activity.isConcert
        ? "bg-gradient-to-r from-red-500 to-pink-500 text-white shadow-pink-300 shadow-xl border-4 border-yellow-300"
        : "bg-white text-gray-800 shadow-lg hover:shadow-xl transition duration-300";

    const Icon = activity.isConcert ? PartyPopper : MapPin;
    const iconColor = activity.isConcert ? "text-yellow-300" : "text-blue-500";
    const titleColor = activity.isConcert ? "text-white" : "text-gray-800";

    return (
        <div className={`p-4 rounded-xl flex items-start space-x-4 ${cardClasses}`}>
            <div className={`p-2 rounded-full ${activity.isConcert ? 'bg-red-700/50' : 'bg-blue-50'}`}>
                <Icon className={`w-6 h-6 ${iconColor}`} />
            </div>
            
            <div className="flex-1 min-w-0">
                {isEditing ? (
                    <div className="space-y-2">
                        <input
                            type="text"
                            value={tempTime}
                            onChange={(e) => setTempTime(e.target.value)}
                            className="w-full text-sm p-1 border rounded-md font-mono text-black"
                            placeholder="時間"
                        />
                        <input
                            type="text"
                            value={tempTitle}
                            onChange={(e) => setTempTitle(e.target.value)}
                            className="w-full text-lg font-bold p-1 border rounded-md text-black"
                            placeholder="標題"
                        />
                        <textarea
                            value={tempDetail}
                            onChange={(e) => setTempDetail(e.target.value)}
                            rows="2"
                            className="w-full text-sm p-1 border rounded-md resize-none text-black"
                            placeholder="詳細內容"
                        />
                    </div>
                ) : (
                    <>
                        <p className={`text-sm font-mono mb-1 ${activity.isConcert ? 'text-white/80' : 'text-gray-500'}`}>{activity.time}</p>
                        <h3 className={`text-lg font-bold ${titleColor}`}>{activity.title}</h3>
                        <p className={`text-sm mt-1 ${activity.isConcert ? 'text-white/90' : 'text-gray-600'}`}>{activity.detail}</p>
                    </>
                )}
            </div>

            <div className="flex flex-col space-y-2">
                {isEditing ? (
                    <button 
                        onClick={handleSave}
                        className="p-2 rounded-full bg-green-500 text-white hover:bg-green-600 transition shadow-md"
                        title="儲存"
                    >
                        <Save className="w-4 h-4" />
                    </button>
                ) : (
                    <button 
                        onClick={() => setIsEditing(true)}
                        className={`p-2 rounded-full hover:bg-opacity-80 transition shadow-md ${activity.isConcert ? 'bg-yellow-400 text-red-700' : 'bg-blue-500 text-white'}`}
                        title="編輯"
                    >
                        <Edit className="w-4 h-4" />
                    </button>
                )}
                {isEditing && (
                    <button 
                        onClick={() => setIsEditing(false)}
                        className="p-2 rounded-full bg-gray-400 text-white hover:bg-gray-500 transition shadow-md"
                        title="取消"
                    >
                        <X className="w-4 h-4" />
                    </button>
                )}
            </div>
        </div>
    );
});


